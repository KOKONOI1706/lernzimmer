# Free key: https://freesound.org/apiv2/apply  (used by npm run assets:sync / assets:search)
FREESOUND_API_KEY=

# Optional: Google Calendar sync. OAuth Web client ID from Google Cloud Console (see docs/GOOGLE_CALENDAR.md).
# Put the real value in .env.local (git-ignored). A client ID is not a secret, but keep it out of the repo anyway.
VITE_GOOGLE_CLIENT_ID=
