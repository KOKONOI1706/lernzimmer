{
  "name": "lernzimmer",
  "version": "0.0.0",
  "private": true,
  "description": "A cozy pixel study room for learning German",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sprites": "node scripts/build-sprites.mjs",
    "sprites:check": "node scripts/build-sprites.mjs --check",
    "assets:sync": "node scripts/sync-assets.mjs",
    "assets:dry": "node scripts/sync-assets.mjs --dry",
    "assets:search": "node scripts/sync-assets.mjs --search"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "dexie": "^4.4.6",
    "konva": "^10.7.0",
    "nanoid": "^6.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
